        h('div',null,h('span',{text:'ฉุกเฉิน / ลงทุน เพิ่ม'}),h('span',{text:'+'+fmt(e.emergAdd)+' / +'+fmt(e.investAdd)})),
        e.debtBefore!=null?h('div',{class:'total'},h('span',{text:'หนี้'}),h('span',{text:fmt(e.debtBefore)+' → '+fmt(e.debtAfter)})):
          h('div',{class:'total'},h('span',{text:'หนี้คงเหลือ'}),h('span',{text:e.debtAfter!=null?fmt(e.debtAfter):'—'}))));
    const head=h('button',{class:'t-head',type:'button','aria-expanded':String(opened),'aria-controls':id+'-b',onclick:()=>{open[id]=!open[id];head.setAttribute('aria-expanded',String(open[id]));body.hidden=!open[id];}},
      h('span',{class:'t-dot','aria-hidden':'true'}),
