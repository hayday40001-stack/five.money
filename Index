function tween(el,to,suffix){
  to=Math.round(to||0);const from=el._v==null?to:el._v;el._v=to;suffix=suffix||'';
  if(reduceMotion||from===to){el.textContent=fmt(to)+suffix;return;}
  const t0=performance.now(),d=260;cancelAnimationFrame(el._raf);
  const step=t=>{const p=Math.min(1,(t-t0)/d),e=1-Math.pow(1-p,3);el.textContent=fmt(from+(to-from)*e)+suffix;if(p<1)el._raf=requestAnimationFrame(step);};
  el._raf=requestAnimationFrame(step);
}

