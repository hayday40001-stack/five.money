  if(S.autoDeduct>S.income)m.append(msgEl('bad','ยอดหักฝากอัตโนมัติมากกว่ารายได้ ตรวจสอบตัวเลขอีกครั้ง'));
  if(S.debt.balance>0&&a.debt<=dm.interest)m.append(msgEl('bad','ยอดที่แบ่งไปชำระหนี้ต่ำกว่าดอกเบี้ยรายเดือน หนี้จะไม่ลดลง'));
  else if(S.debt.balance>0&&S.debt.minPay>0&&a.debt<S.debt.minPay)m.append(msgEl('warn','ยอดชำระหนี้ต่ำกว่ายอดขั้นต่ำตามใบแจ้งยอด'));
  if(et.left>0&&S.pct.emerg===0)m.append(msgEl('warn','เงินฉุกเฉินยังไม่พอ แต่ไม่ได้แบ่งเงินเข้ากระเป๋านี้'));
  if(S.debt.balance>0&&S.pct.invest>0)m.append(msgEl('info','ระหว่างที่ยังมีหนี้ดอกเบี้ยสูง ลองย้ายส่วนลงทุนไปปลดหนี้ก่อน'));
  if(S.debt.balance<=0&&S.pct.debt>0)m.append(msgEl('info','หนี้หมดแล้ว ลองสูตร "หนี้หมดแล้ว" เพื่อย้ายเงินไปเก็บและลงทุน'));
  if(lp<40&&a.life>0)m.append(msgEl('warn',`ค่าใช้จ่ายในชีวิตเหลือ ${lp}% (${fmt(a.life)} บาท) ตรวจสอบว่าพอใช้จริง`));
  if(lp===0)m.append(msgEl('bad','ไม่เหลือเงินสำหรับค่าใช้จ่ายในชีวิต ลดสัดส่วนกระเป๋าอื่นลง'));
  if(!m.childElementCount)m.append(msgEl('ok','สัดส่วนนี้สมดุลดี ทำตามต่อเนื่องได้เลย'));
}
function renderClose(net,a,dm){
  const closed=isClosed(S,period);
  $('closeSub').textContent='รายงานรอบ '+periodLabel(period);
  const rep=$('preReport');rep.replaceChildren();
  const row=(k,v,cls)=>h('div',{class:cls||null},h('span',{text:k}),h('span',{text:v}));
  if(closed){
    const e=S.history.find(x=>x.id===period);
    rep.append(row('รายได้ / แบ่งในระบบ',fmt(e.income)+' / '+fmt(e.net!=null?e.net:e.income)),row('ชำระหนี้',fmt(e.debtPaid)+' บาท'),row('ดอกเบี้ยประมาณ',e.interest!=null?fmt(e.interest)+' บาท':'—'),
      row('เงินฉุกเฉินเพิ่ม','+'+fmt(e.emergAdd)+' บาท'),row('เงินลงทุนเพิ่ม','+'+fmt(e.investAdd)+' บาท'),row('หนี้คงเหลือหลังปิด',e.debtAfter!=null?fmt(e.debtAfter)+' บาท':'—','total'));
  }else{
    rep.append(row('เงินแบ่งในระบบ',fmt(net)+' บาท'),row('ชำระหนี้',fmt(dm.paid)+' บาท'),row('ดอกเบี้ยประมาณ',fmt(dm.interest)+' บาท'),
      row('เงินฉุกเฉินเพิ่ม','+'+fmt(a.emerg)+' บาท'),row('เงินลงทุนเพิ่ม','+'+fmt(a.invest)+' บาท'),row('หนี้คงเหลือหลังปิด',fmt(dm.after)+' บาท','total'));
  }
  const area=$('closeArea');area.replaceChildren();
  if(closed){
    const e=S.history.find(x=>x.id===period);
    area.append(h('div',{class:'closed'},icon('check'),h('span',{text:'ปิดรอบ '+periodLabel(period)+' แล้ว'})));
    if(e&&e.debtBefore!=null&&S.history[0]&&S.history[0].id===period)
      area.append(h('button',{class:'btn ghost block',type:'button',onclick:()=>openUndo(period)},icon('reset'),'ยกเลิกการปิดรอบนี้'));
  }else{
    const b=h('button',{class:'btn block',type:'button',id:'closeBtn',onclick:()=>openClose()},icon('cal'),'ปิดรอบ '+periodLabel(period));
    if(net<=0){b.disabled=true;}
    area.append(b);
    if(net<=0)area.append(h('p',{class:'sub',text:'กรอกรายได้ก่อนปิดเดือน'}));
  }
}
function renderInsights(net,a,pcts){
  const w=$('insights');w.replaceChildren();
  const card=(k,v,s)=>h('div',{class:'ins'},h('span',{text:k}),h('b',{text:v}),s?h('small',{text:s}):null);
  w.append(card('เดือนนี้แบ่งไปเก็บ',fmt(a.emerg+a.invest)+' บาท',net>0?Math.round((a.emerg+a.invest)/net*100)+'% ของยอดที่แบ่ง':null));
  const last=S.history.find(h=>h.debtBefore!=null&&h.debtAfter!=null);
  w.append(last?card('หนี้ลดลงเดือนล่าสุด',fmt(last.debtBefore-last.debtAfter)+' บาท',last.label):card('หนี้ลดลงเดือนล่าสุด','—','ยังไม่มีเดือนที่ปิด'));
  const paidAll=S.history.reduce((s,h)=>s+h.debtPaid,0);
  w.append(card('ชำระหนี้สะสม',fmt(paidAll)+' บาท',S.history.length+' เดือนที่ปิดแล้ว'));
  w.append(card('เงินเก็บ + ลงทุนสะสม',fmt(S.emerg.saved+S.invest.total)+' บาท','ไม่รวมกำไรจากการลงทุน'));
  // donut
  const svg=$('donut');svg.replaceChildren();const R=46,C=2*Math.PI*R;let off=0;
  svg.append(sv('circle',{cx:60,cy:60,r:R,fill:'none',stroke:'var(--line)','stroke-width':14}));
  for(const p of POCKETS){const f=pcts[p.k]/100;if(f<=0)continue;
    const seg=sv('circle',{cx:60,cy:60,r:R,fill:'none',stroke:`var(--${p.k})`,'stroke-width':14,'stroke-dasharray':`${Math.max(0,f*C-1.5)} ${C}`,'stroke-dashoffset':String(-off),transform:'rotate(-90 60 60)'});
    svg.append(seg);off+=f*C;}
  const t1=sv('text',{x:60,y:57,'text-anchor':'middle','font-size':'15','font-weight':'700',fill:'var(--ink)','font-family':'Bai Jamjuree, sans-serif'});t1.textContent=fmt(net);
  const t2=sv('text',{x:60,y:73,'text-anchor':'middle','font-size':'8.5',fill:'var(--muted)'});t2.textContent='บาทที่แบ่ง';
  svg.append(t1,t2);
  const dl=$('donutLegend');dl.replaceChildren();
  for(const p of POCKETS)dl.append(h('div',null,h('i',{style:`background:var(--${p.k})`}),h('span',{text:p.name.replace(' KTC PROUD','')}),h('span',{text:fmt(a[p.k])+' · '+pcts[p.k]+'%'})));
}
function emptyState(text){return h('div',{class:'empty'},icon('chart'),h('span',{text}));}
function renderCharts(){
  const hist=S.history.filter(h=>validPeriod(h.id)).slice().reverse().slice(-12);
  // debt bars
  const dc=$('debtChart');dc.replaceChildren();
  const dh=hist.filter(h=>h.debtAfter!=null);
  if(dh.length<2)dc.append(emptyState('ปิดเดือนอย่างน้อย 2 เดือนเพื่อดูแนวโน้มยอดหนี้'));
  else{
    const W=320,H=150,pl=8,pr=8,pt=18,pb=22,max=Math.max(...dh.map(h=>Math.max(h.debtAfter,h.debtBefore||0)),1);
    const svg=sv('svg',{viewBox:`0 0 ${W} ${H}`,role:'img','aria-label':'กราฟแท่งยอดหนี้คงเหลือรายเดือน'});
    const bw=(W-pl-pr)/dh.length;
    svg.append(sv('line',{x1:pl,x2:W-pr,y1:H-pb,y2:H-pb,stroke:'var(--line-strong)','stroke-width':1}));
    dh.forEach((h,i)=>{const v=h.debtAfter,bh=(H-pt-pb)*v/max,x=pl+i*bw+bw*0.2,w=bw*0.6;
      svg.append(sv('rect',{x,y:H-pb-bh,width:w,height:Math.max(bh,0.5),rx:3,fill:'var(--debt)',opacity:i===dh.length-1?'1':'.55'}));
      const lab=sv('text',{x:x+w/2,y:H-6,'text-anchor':'middle','font-size':'9',fill:'var(--muted)'});lab.textContent=periodLabel(h.id,true);svg.append(lab);
      if(i===0||i===dh.length-1){const vt=sv('text',{x:x+w/2,y:H-pb-bh-5,'text-anchor':'middle','font-size':'9.5','font-weight':'600',fill:'var(--ink)'});vt.textContent=fmt(v);svg.append(vt);}});
    dc.append(svg);
  }
  // savings lines
  const scw=$('saveChart');scw.replaceChildren();
  const shh=hist.filter(h=>h.emergAfter!=null&&h.investAfter!=null);
  if(shh.length<2)scw.append(emptyState('ปิดเดือนอย่างน้อย 2 เดือนเพื่อดูเงินฉุกเฉินและเงินลงทุนสะสม'));
  else{
    const W=320,H=150,pl=8,pr=8,pt=16,pb=22,max=Math.max(...shh.map(h=>Math.max(h.emergAfter,h.investAfter)),1);
    const svg=sv('svg',{viewBox:`0 0 ${W} ${H}`,role:'img','aria-label':'กราฟเงินฉุกเฉินและเงินลงทุนสะสม'});
    const X=i=>pl+(W-pl-pr)*(shh.length===1?0.5:i/(shh.length-1)),Y=v=>H-pb-(H-pt-pb)*v/max;
    [0.5,1].forEach(f=>svg.append(sv('line',{x1:pl,x2:W-pr,y1:Y(max*f),y2:Y(max*f),stroke:'var(--line)','stroke-width':1,'stroke-dasharray':'3 4'})));
    svg.append(sv('line',{x1:pl,x2:W-pr,y1:H-pb,y2:H-pb,stroke:'var(--line-strong)','stroke-width':1}));
    for(const [key,col] of [['emergAfter','var(--emerg)'],['investAfter','var(--invest)']]){
      const pts=shh.map((h,i)=>X(i)+','+Y(h[key])).join(' ');
      svg.append(sv('polygon',{points:`${X(0)},${H-pb} ${pts} ${X(shh.length-1)},${H-pb}`,fill:col,opacity:'.1'}));
      svg.append(sv('polyline',{points:pts,fill:'none',stroke:col,'stroke-width':2,'stroke-linejoin':'round','stroke-linecap':'round'}));
      const l=shh[shh.length-1];svg.append(sv('circle',{cx:X(shh.length-1),cy:Y(l[key]),r:3.5,fill:col}));
    }
    shh.forEach((h,i)=>{if(shh.length>6&&i%2&&i!==shh.length-1)return;const t=sv('text',{x:X(i),y:H-6,'text-anchor':i===0?'start':(i===shh.length-1?'end':'middle'),'font-size':'9',fill:'var(--muted)'});t.textContent=periodLabel(h.id,true);svg.append(t);});
    scw.append(svg);
  }
}
