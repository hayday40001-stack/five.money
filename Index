/* ---------- modal ---------- */
let lastFocus=null;
function modal(title,content,actions){
  lastFocus=document.activeElement;
  const root=$('modalRoot');root.replaceChildren();
  const close=()=>{root.replaceChildren();document.removeEventListener('keydown',onKey);if(lastFocus&&lastFocus.focus)lastFocus.focus();};
  const sheet=h('div',{class:'sheet',role:'dialog','aria-modal':'true','aria-labelledby':'mTitle'},
    h('div',{class:'sheet-h'},h('h2',{id:'mTitle',text:title}),h('button',{class:'icon-btn',type:'button','aria-label':'ปิด',onclick:close},icon('x'))),
    content,h('div',{class:'btn-row'},actions(close)));
  const scrim=h('div',{class:'scrim',onclick:e=>{if(e.target===scrim)close();}},sheet);
  function onKey(e){if(e.key==='Escape'){close();return;}
    if(e.key==='Tab'){const f=sheet.querySelectorAll('button:not([disabled])');if(!f.length)return;const a=f[0],z=f[f.length-1];
      if(e.shiftKey&&document.activeElement===a){e.preventDefault();z.focus();}else if(!e.shiftKey&&document.activeElement===z){e.preventDefault();a.focus();}}}
  document.addEventListener('keydown',onKey);root.append(scrim);
  const primary=sheet.querySelector('.btn-row .btn:not(.ghost)');(primary||sheet.querySelector('button')).focus();
  return close;
}
function openClose(){
  if(busy)return;
  if(isClosed(S,period)){render();return;}
  const {net,a}=allocate(S),dm=debtMonth(S,a.debt);
  const row=(k,v,cls)=>h('div',{class:cls||null},h('span',{text:k}),h('span',{text:v}));
  const content=h('div',{style:'display:flex;flex-direction:column;gap:12px'},
    h('p',{class:'sub',text:'ตรวจสอบยอดก่อนบันทึก เมื่อยืนยันแล้ว ระบบจะปรับยอดหนี้ เงินฉุกเฉิน และเงินลงทุนให้'}),
    h('div',{class:'report'},
      row('รายได้ทั้งหมด',fmt(S.income)+' บาท'),row('หักฝากอัตโนมัติแล้ว',fmt(S.autoDeduct)+' บาท'),row('แบ่งในระบบ',fmt(net)+' บาท','total'),
      row('ชำระหนี้',fmt(dm.paid)+' บาท'),row('ดอกเบี้ยประมาณ',fmt(dm.interest)+' บาท'),row('ตัดเงินต้น',(dm.principal<0?'−':'')+fmt(Math.abs(dm.principal))+' บาท'),
      row('เงินฉุกเฉิน',fmt(S.emerg.saved)+' → '+fmt(S.emerg.saved+a.emerg)),row('เงินลงทุน (เงินต้น)',fmt(S.invest.total)+' → '+fmt(S.invest.total+a.invest)),
      row('หนี้คงเหลือหลังบันทึก',fmt(dm.after)+' บาท','total')),
    dm.unused>0.5&&S.debt.balance>0?msgEl('info',`ยอดจ่ายเกินหนี้ ${fmt(dm.unused)} บาท ส่วนนี้จะไม่ถูกนับ`):null,
    S.debt.balance<=0&&a.debt>0?msgEl('warn',`ไม่มีหนี้แล้ว เงินกระเป๋าปลดหนี้ ${fmt(a.debt)} บาท จะไม่ถูกบันทึกที่ใด`):null);
  modal('ปิดรอบ '+periodLabel(period),content,close=>[
    h('button',{class:'btn ghost',type:'button',onclick:close},'ยกเลิก'),
    h('button',{class:'btn',type:'button',onclick:async e=>{
      if(busy)return;busy=true;e.currentTarget.disabled=true;
      const res=closeMonth(S,period);
      if(!res.ok){busy=false;close();render();return;}
      S.sample=false;render();close();
      await save(true);busy=false;render();
      const b=document.querySelector('.closed');if(b&&b.scrollIntoView)b.scrollIntoView({block:'nearest',behavior:reduceMotion?'auto':'smooth'});
    }},icon('check'),'ยืนยันปิดเดือน')]);
}
function openUndo(pid){
  const e=S.history.find(x=>x.id===pid);if(!e)return;
  const content=h('div',{style:'display:flex;flex-direction:column;gap:10px'},
    h('p',{text:`ระบบจะคืนยอดหนี้ +${fmt(e.debtBefore-e.debtAfter)} บาท หักเงินฉุกเฉิน −${fmt(e.emergAdd)} และเงินลงทุน −${fmt(e.investAdd)} บาท แล้วลบรายงานรอบนี้`}),
    msgEl('warn','ใช้เมื่อกดปิดเดือนผิดเท่านั้น'));
  modal('ยกเลิกการปิดรอบ '+e.label,content,close=>[
    h('button',{class:'btn ghost',type:'button',onclick:close},'กลับ'),
    h('button',{class:'btn',type:'button',onclick:async ev=>{if(busy)return;busy=true;ev.currentTarget.disabled=true;undoClose(S,pid);render();close();await save(true);busy=false;render();}},'ยืนยันยกเลิก')]);
}

/* ---------- events ---------- */
function change(debounced){render();save();}
$('income').addEventListener('input',e=>{S.income=parseNum(e.target.value);S.sample=false;change();});
$('income').addEventListener('blur',()=>{$('income').value=fmt(S.income);});
$('autoDeduct').addEventListener('input',e=>{S.autoDeduct=parseNum(e.target.value);S.sample=false;change();});
$('autoDeduct').addEventListener('blur',()=>{$('autoDeduct').value=fmt(S.autoDeduct);});
$('period').addEventListener('change',e=>{if(validPeriod(e.target.value)){period=e.target.value;render();}else{e.target.value=period;}});
$('resetBtn').addEventListener('click',()=>{if(activePreset(S)==='payoff')return;$('resetConfirm').hidden=false;$('resetYes').focus();});
$('resetNo').addEventListener('click',()=>{$('resetConfirm').hidden=true;$('resetBtn').focus();});
$('resetYes').addEventListener('click',()=>{S.pct=Object.assign({},PRESETS[0].pct);$('resetConfirm').hidden=true;change();});

/* ---------- boot ---------- */
paintThemeBtn();buildPresets();buildPockets();
const local=lsGet();
if(local){S=sanitize(local);}
render();setSave('idle','บันทึกในเครื่องนี้');
(async()=>{
  try{
    const c=window.claude;if(!c||typeof c.use!=='function'){storageMode='local';setSave('saved','บันทึกในเครื่องนี้');return;}
    const [db,user]=await Promise.all([c.use('db'),c.use('user')]);
    if(!db||!user){setSave('saved','บันทึกในเครื่องนี้');return;}
    const id=await user.id();if(!id){setSave('saved','บันทึกในเครื่องนี้');return;}
    docRef=db.doc('data/users/'+id+'/fourpockets');storageMode='remote';
    const snap=await docRef.get();
    if(snap.exists){S=sanitize(snap.data());lsSet();render();setSave('saved','ซิงก์แล้ว');}
    else{await save(true);}
  }catch(e){docRef=null;storageMode='local';setSave('error','เชื่อมต่อไม่ได้ เก็บในเครื่องนี้');}
})();
})();
