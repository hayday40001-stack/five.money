<title>ห้ากระเป๋าเงิน</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@500;600;700&family=IBM+Plex+Sans+Thai:wght@400;500;600&display=swap">
<style>
/* Layout: mobile = one column (hero → split → pockets → month close → insights → history); desktop = two columns, planning left, reporting right */
:root{
  --bg:#f2f5f1; --surface:#ffffff; --surface-2:#f7f9f6; --ink:#16231d; --muted:#5c6b63; --faint:#8a978f; --line:#e1e7e2; --line-strong:#cdd6cf;
  --primary:#145a40; --primary-ink:#ffffff; --primary-soft:#e3efe8;
  --hero:#0f3d2c; --hero-2:#16503a; --hero-ink:#f3f8f4; --hero-muted:#a9c7b6; --hero-line:rgba(255,255,255,.14);
  --life:#2f8580; --fun:#b4507c; --debt:#b8483a; --emerg:#b8861a; --invest:#3c68b3;
  --ok:#2c7a4b; --ok-bg:#e6f2ea; --warn:#9a6a0c; --warn-bg:#fbf2df; --bad:#b03a2e; --bad-bg:#fbe9e6; --info-bg:#eaf0f5;
  --shadow:0 1px 2px rgba(20,40,30,.05),0 4px 16px rgba(20,40,30,.05);
  --display:"Bai Jamjuree","IBM Plex Sans Thai",system-ui,sans-serif;
  --body:"IBM Plex Sans Thai",system-ui,-apple-system,sans-serif;
  --r-lg:20px; --r-md:14px; --r-sm:10px;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0d1411; --surface:#141d19; --surface-2:#18231e; --ink:#e6eee9; --muted:#9db0a6; --faint:#71847a; --line:#24302b; --line-strong:#33423b;
  --primary:#4cc28e; --primary-ink:#06231a; --primary-soft:#173528;
  --hero:#123a2a; --hero-2:#184a36; --hero-ink:#eef6f1; --hero-muted:#9cc3ae; --hero-line:rgba(255,255,255,.12);
  --life:#5cbcb5; --fun:#e283ad; --debt:#ec7d6d; --emerg:#e3b44e; --invest:#7ea3e8;
  --ok:#6fd39a; --ok-bg:#16301f; --warn:#e6b85c; --warn-bg:#2f2614; --bad:#f08b7d; --bad-bg:#35201c; --info-bg:#18242e;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 4px 16px rgba(0,0,0,.25); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0d1411; --surface:#141d19; --surface-2:#18231e; --ink:#e6eee9; --muted:#9db0a6; --faint:#71847a; --line:#24302b; --line-strong:#33423b;
  --primary:#4cc28e; --primary-ink:#06231a; --primary-soft:#173528;
  --hero:#123a2a; --hero-2:#184a36; --hero-ink:#eef6f1; --hero-muted:#9cc3ae; --hero-line:rgba(255,255,255,.12);
  --life:#5cbcb5; --fun:#e283ad; --debt:#ec7d6d; --emerg:#e3b44e; --invest:#7ea3e8;
  --ok:#6fd39a; --ok-bg:#16301f; --warn:#e6b85c; --warn-bg:#2f2614; --bad:#f08b7d; --bad-bg:#35201c; --info-bg:#18242e;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 4px 16px rgba(0,0,0,.25); color-scheme:dark}

*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-block:16px calc(40px + env(safe-area-inset-bottom,0px))}
h1,h2,h3{font-family:var(--display);margin:0;line-height:1.2;text-wrap:balance}
p{margin:0}
button{font:inherit;color:inherit}
.num{font-variant-numeric:tabular-nums}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
svg.i{width:20px;height:20px;flex:none;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.app{max-width:1120px;margin:0 auto;display:grid;gap:16px}
.col{display:flex;flex-direction:column;gap:16px;min-width:0}
@media (min-width:920px){.app{grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);align-items:start;gap:20px}.topbar{grid-column:1/-1}.col.side{position:sticky;top:16px}}

/* top bar */
.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{display:flex;align-items:center;gap:12px;min-width:0}
.logo{width:42px;height:42px;border-radius:13px;background:var(--hero);display:grid;place-items:center;flex:none;position:relative;overflow:hidden}
.logo span{position:absolute;width:9px;height:9px;border-radius:3px}
.brand h1{font-size:1.3rem;font-weight:700;letter-spacing:.01em}
.brand p{font-size:.82rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tools{display:flex;align-items:center;gap:8px;flex:none}
.pill{display:inline-flex;align-items:center;gap:6px;font-size:.75rem;color:var(--muted);background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:5px 10px;white-space:nowrap}
.pill .d{width:7px;height:7px;border-radius:50%;background:var(--faint)}
.pill[data-s="saving"] .d{background:var(--emerg)}
.pill[data-s="saved"] .d{background:var(--ok)}
.pill[data-s="error"] .d{background:var(--bad)}
.icon-btn{width:42px;height:42px;border-radius:12px;border:1px solid var(--line);background:var(--surface);display:grid;place-items:center;cursor:pointer;color:var(--ink)}
.icon-btn:hover{border-color:var(--line-strong)}
.icon-btn:active{transform:scale(.96)}
@media (max-width:420px){.pill .t{display:none}.pill{padding:8px}}

/* hero */
.hero{background:var(--hero);background-image:radial-gradient(120% 90% at 100% 0%,var(--hero-2) 0%,transparent 60%);color:var(--hero-ink);border-radius:var(--r-lg);padding:20px;display:flex;flex-direction:column;gap:16px;box-shadow:var(--shadow)}
.hero-top{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.month{display:inline-flex;align-items:center;gap:8px;font-size:.85rem;color:var(--hero-muted)}
.month input{background:transparent;border:1px solid var(--hero-line);color:var(--hero-ink);border-radius:9px;padding:4px 8px;font:inherit;font-size:.85rem;color-scheme:dark;min-height:34px}
.tag{font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--hero-muted)}
.income-row label{display:block;font-size:.8rem;color:var(--hero-muted);margin-bottom:2px}
.income-in{display:flex;align-items:baseline;gap:8px;border-bottom:1px solid var(--hero-line);padding-bottom:4px}
.income-in:focus-within{border-bottom-color:var(--hero-ink)}
.income-in input{flex:1;min-width:0;background:transparent;border:0;color:var(--hero-ink);font-family:var(--display);font-weight:700;font-size:2.4rem;letter-spacing:-.01em;padding:0;font-variant-numeric:tabular-nums}
.income-in input:focus{outline:none}
.income-in span{color:var(--hero-muted);font-size:.95rem}
.sample{font-size:.78rem;color:var(--hero-muted)}
.flow{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center;border:1px solid var(--hero-line);border-radius:var(--r-md);padding:12px}
.flow>div{min-width:0}
.flow .k{font-size:.75rem;color:var(--hero-muted)}
.flow .v{font-family:var(--display);font-weight:600;font-size:1.05rem}
.flow .op{color:var(--hero-muted);font-size:1.1rem}
.flow input{width:100%;background:transparent;border:0;border-bottom:1px dashed var(--hero-line);color:var(--hero-ink);font-family:var(--display);font-weight:600;font-size:1.05rem;padding:0;font-variant-numeric:tabular-nums}
.flow input:focus{outline:none;border-bottom-color:var(--hero-ink)}
.flow .net{grid-column:1/-1;display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid var(--hero-line);padding-top:10px;margin-top:2px}
.flow .net .v{font-size:1.35rem}
.sums{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.sum{background:rgba(255,255,255,.06);border:1px solid var(--hero-line);border-radius:12px;padding:10px;min-width:0}
.sum .k{font-size:.72rem;color:var(--hero-muted);display:flex;align-items:center;gap:6px}
.sum .k i{width:8px;height:8px;border-radius:2px;flex:none}
.sum .v{font-family:var(--display);font-weight:600;font-size:1.05rem;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.split{display:flex;height:10px;border-radius:5px;overflow:hidden;background:var(--hero-line);gap:2px}
.split span{height:100%;transition:width .35s cubic-bezier(.2,.7,.2,1);min-width:0}
.legend{display:flex;flex-wrap:wrap;gap:4px 12px;font-size:.76rem;color:var(--hero-muted)}
.legend span{display:inline-flex;align-items:center;gap:5px}
.legend i{width:8px;height:8px;border-radius:2px}

/* section card */
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:18px;display:flex;flex-direction:column;gap:14px;box-shadow:var(--shadow)}
.card-h{display:flex;justify-content:space-between;align-items:center;gap:10px}
.card-h h2{font-size:1.08rem;font-weight:600}
.sub{font-size:.84rem;color:var(--muted)}
.presets{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px;margin:0 -2px}
.presets::-webkit-scrollbar{display:none}
.preset{flex:none;border:1px solid var(--line);background:var(--surface-2);border-radius:12px;padding:9px 12px;cursor:pointer;text-align:left;min-height:44px;display:flex;flex-direction:column;gap:1px}
.preset b{font-weight:600;font-size:.88rem}
.preset small{font-size:.72rem;color:var(--muted);font-variant-numeric:tabular-nums}
.preset:hover{border-color:var(--line-strong)}
.preset[aria-pressed="true"]{background:var(--primary-soft);border-color:var(--primary)}
.preset[aria-pressed="true"] b{color:var(--primary)}
.link-btn{display:inline-flex;align-items:center;gap:6px;background:none;border:0;color:var(--muted);font-size:.84rem;cursor:pointer;padding:8px 4px;min-height:40px;border-radius:8px}
.link-btn:hover{color:var(--ink)}
.link-btn svg.i{width:16px;height:16px}
.inline-confirm{display:flex;flex-wrap:wrap;align-items:center;gap:8px;background:var(--surface-2);border:1px solid var(--line);border-radius:12px;padding:10px 12px;font-size:.86rem}
.advice{display:flex;flex-direction:column;gap:8px}
.msg{display:flex;gap:10px;align-items:flex-start;border-radius:12px;padding:10px 12px;font-size:.86rem;background:var(--info-bg)}
.msg svg.i{width:18px;height:18px;margin-top:1px}
.msg.ok{background:var(--ok-bg)}.msg.ok svg{color:var(--ok)}
.msg.warn{background:var(--warn-bg)}.msg.warn svg{color:var(--warn)}
.msg.bad{background:var(--bad-bg)}.msg.bad svg{color:var(--bad)}

/* pockets */
.pockets{display:flex;flex-direction:column;gap:12px}
.pocket{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:16px;display:flex;flex-direction:column;gap:12px;box-shadow:var(--shadow)}
.p-top{display:flex;align-items:flex-start;gap:12px}
.p-ic{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;flex:none;color:var(--c);background:color-mix(in srgb,var(--c) 13%,transparent)}
.p-title{flex:1;min-width:0}
.p-title h3{font-size:1rem;font-weight:600}
.p-title p{font-size:.8rem;color:var(--muted)}
.p-amt{text-align:right;flex:none}
.p-amt b{display:block;font-family:var(--display);font-weight:700;font-size:1.35rem;line-height:1.15;font-variant-numeric:tabular-nums}
.p-amt small{font-size:.78rem;color:var(--muted);font-variant-numeric:tabular-nums}
.meter{height:6px;border-radius:3px;background:var(--line);overflow:hidden}
.meter span{display:block;height:100%;background:var(--c);border-radius:3px;transition:width .35s cubic-bezier(.2,.7,.2,1)}
.adjust{display:flex;align-items:center;gap:10px}
.step{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:var(--surface-2);display:grid;place-items:center;cursor:pointer;flex:none;color:var(--ink)}
.step:hover{border-color:var(--line-strong)}
.step:active{transform:scale(.94)}
.step:disabled{opacity:.4;cursor:not-allowed;transform:none}
.step svg.i{width:16px;height:16px}
input[type=range]{-webkit-appearance:none;appearance:none;flex:1;min-width:0;height:40px;background:transparent;cursor:pointer;margin:0}
input[type=range]::-webkit-slider-runnable-track{height:6px;border-radius:3px;background:linear-gradient(to right,var(--c) 0 var(--fill,0%),var(--line) var(--fill,0%) 100%)}
input[type=range]::-moz-range-track{height:6px;border-radius:3px;background:var(--line)}
input[type=range]::-moz-range-progress{height:6px;border-radius:3px;background:var(--c)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:26px;height:26px;border-radius:50%;background:var(--surface);border:2px solid var(--c);margin-top:-10px;box-shadow:0 1px 4px rgba(0,0,0,.18)}
input[type=range]::-moz-range-thumb{width:22px;height:22px;border-radius:50%;background:var(--surface);border:2px solid var(--c);box-shadow:0 1px 4px rgba(0,0,0,.18)}
.auto-note{font-size:.8rem;color:var(--muted);display:flex;align-items:center;gap:6px}
.auto-note svg.i{width:16px;height:16px}
.toggle{display:flex;align-items:center;justify-content:space-between;width:100%;background:none;border:0;border-top:1px solid var(--line);padding:10px 0 0;cursor:pointer;font-size:.85rem;color:var(--muted);min-height:40px}
.toggle:hover{color:var(--ink)}
.toggle svg.i{width:18px;height:18px;transition:transform .25s}
.toggle[aria-expanded="true"] svg.i{transform:rotate(180deg)}
.details{display:flex;flex-direction:column;gap:12px}
.details:not([hidden]){animation:reveal .28s ease}
@keyframes reveal{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
.kv{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.kv div{background:var(--surface-2);border:1px solid var(--line);border-radius:12px;padding:10px;min-width:0}
.kv span{display:block;font-size:.74rem;color:var(--muted)}
.kv b{font-family:var(--display);font-weight:600;font-size:1rem;font-variant-numeric:tabular-nums}
.big{font-family:var(--display);font-weight:700;font-size:1.7rem;font-variant-numeric:tabular-nums;line-height:1.1}
.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.field{display:flex;flex-direction:column;gap:4px;min-width:0}
.field label{font-size:.76rem;color:var(--muted)}
.field input{width:100%;min-height:42px;border:1px solid var(--line);background:var(--surface-2);color:var(--ink);border-radius:10px;padding:8px 10px;font:inherit;font-variant-numeric:tabular-nums}
.field input:hover{border-color:var(--line-strong)}
.field input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-soft)}
.field .hint{font-size:.72rem;color:var(--faint)}
.bar-prog{height:10px;border-radius:5px;background:var(--line);overflow:hidden}
.bar-prog span{display:block;height:100%;background:var(--c);border-radius:5px;transition:width .5s cubic-bezier(.2,.7,.2,1)}
.row-between{display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap}
.disclaim{font-size:.74rem;color:var(--faint)}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:10px 16px;border-radius:12px;border:1px solid var(--primary);background:var(--primary);color:var(--primary-ink);font-weight:600;cursor:pointer}
.btn:hover{filter:brightness(1.06)}
.btn:active{transform:scale(.98)}
.btn:disabled{opacity:.45;cursor:not-allowed;filter:none;transform:none}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--line-strong)}
.btn.small{min-height:38px;padding:6px 12px;font-size:.86rem}
.btn.block{width:100%}
:focus-visible{outline:2px solid var(--primary);outline-offset:2px}

/* report */
.report{display:flex;flex-direction:column;gap:0;border:1px solid var(--line);border-radius:var(--r-md);overflow:hidden}
.report div{display:flex;justify-content:space-between;gap:12px;padding:10px 12px;font-size:.88rem;border-top:1px solid var(--line)}
.report div:first-child{border-top:0}
.report div span:last-child{font-variant-numeric:tabular-nums;font-weight:500}
.report .total{background:var(--surface-2);font-weight:600}
.closed{display:flex;align-items:center;gap:8px;font-size:.86rem;color:var(--ok)}

/* insights + charts */
.insights{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.ins{background:var(--surface-2);border:1px solid var(--line);border-radius:12px;padding:12px;min-width:0}
.ins span{display:block;font-size:.76rem;color:var(--muted)}
.ins b{font-family:var(--display);font-weight:700;font-size:1.15rem;font-variant-numeric:tabular-nums}
.ins small{display:block;font-size:.72rem;color:var(--faint)}
.donut-wrap{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.donut{width:150px;height:150px;flex:none}
.donut-legend{display:flex;flex-direction:column;gap:6px;font-size:.84rem;flex:1;min-width:160px}
.donut-legend div{display:flex;align-items:center;gap:8px}
.donut-legend i{width:10px;height:10px;border-radius:3px;flex:none}
.donut-legend span:nth-child(2){flex:1;color:var(--muted)}
.donut-legend span:last-child{font-variant-numeric:tabular-nums;font-weight:500}
.chart{width:100%;overflow-x:auto}
.chart svg{display:block;width:100%;min-width:280px;height:auto}
.empty{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;padding:22px 12px;border:1px dashed var(--line-strong);border-radius:var(--r-md);color:var(--muted);font-size:.86rem}
.empty svg.i{width:28px;height:28px;color:var(--faint)}
.chart-legend{display:flex;gap:14px;font-size:.78rem;color:var(--muted)}
.chart-legend span{display:inline-flex;align-items:center;gap:6px}
.chart-legend i{width:14px;height:3px;border-radius:2px}

/* history */
.timeline{display:flex;flex-direction:column}
.t-item{border-top:1px solid var(--line)}
.t-item:first-child{border-top:0}
.t-head{display:grid;grid-template-columns:auto 1fr auto auto;align-items:center;gap:10px;width:100%;background:none;border:0;padding:12px 0;cursor:pointer;text-align:left;min-height:52px}
.t-dot{width:10px;height:10px;border-radius:50%;background:var(--primary);box-shadow:0 0 0 4px var(--primary-soft)}
.t-head b{font-weight:600}
.t-head small{display:block;font-size:.76rem;color:var(--muted)}
.t-head .r{text-align:right;font-variant-numeric:tabular-nums;font-size:.86rem}
.t-head svg.i{width:18px;height:18px;color:var(--muted);transition:transform .25s}
.t-head[aria-expanded="true"] svg.i{transform:rotate(180deg)}
.t-body{padding:0 0 14px 20px}
.t-body:not([hidden]){animation:reveal .25s ease}
.totals{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}

/* modal */
.scrim{position:fixed;inset:0;background:rgba(8,16,12,.5);display:grid;place-items:end center;z-index:50;padding:0 max(0px,env(safe-area-inset-right,0px)) 0 max(0px,env(safe-area-inset-left,0px))}
.sheet{background:var(--surface);color:var(--ink);width:min(520px,100%);border-radius:22px 22px 0 0;padding:20px max(18px,env(safe-area-inset-left,0px)) calc(20px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;gap:14px;max-height:90vh;overflow-y:auto;box-shadow:0 -8px 40px rgba(0,0,0,.25);animation:up .28s cubic-bezier(.2,.7,.2,1)}
@media (min-width:640px){.scrim{place-items:center}.sheet{border-radius:22px;padding-bottom:20px}}
@keyframes up{from{transform:translateY(24px);opacity:0}to{transform:none;opacity:1}}
.sheet-h{display:flex;justify-content:space-between;align-items:center;gap:10px}
.sheet-h h2{font-size:1.15rem}
.btn-row{display:flex;gap:8px}
.btn-row .btn{flex:1}

/* fit to phone screens */
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{overflow-x:clip}
.app,.col,.card,.pocket,.hero{min-width:0;max-width:100%}
.chart svg{min-width:0}
.sheet{max-height:90dvh}
input,select,textarea{font-size:16px}
@media (max-width:560px){
  body{padding-block:10px calc(28px + env(safe-area-inset-bottom,0px))}
  .app,.col{gap:12px}
  .logo{width:36px;height:36px;border-radius:11px}
  .logo span{width:8px;height:8px}
  .logo span:nth-child(1),.logo span:nth-child(3){left:7px!important}
  .logo span:nth-child(2),.logo span:nth-child(4){right:7px!important}
  .logo span:nth-child(1),.logo span:nth-child(2){top:7px!important}
  .logo span:nth-child(3),.logo span:nth-child(4){bottom:7px!important}
  .logo span:nth-child(5){left:14px!important;top:14px!important}
  .brand{gap:10px}
  .brand h1{font-size:1.12rem}
  .brand p{font-size:.74rem}
