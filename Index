function lsGet(){try{const r=localStorage.getItem(LS_KEY);return r?JSON.parse(r):null}catch(e){return null}}
function lsSet(){try{localStorage.setItem(LS_KEY,JSON.stringify(S));return true}catch(e){return false}}
function setSave(s,t){const p=$('saveState');p.dataset.s=s;$('saveText').textContent=t;}
async function pushRemote(){
  if(!docRef){setSave('saved',storageMode==='local'?'บันทึกในเครื่องนี้':'บันทึกแล้ว');return true;}
  setSave('saving','กำลังบันทึก');
  try{await docRef.set(JSON.parse(JSON.stringify(S)));setSave('saved','บันทึกแล้ว');return true;}
  catch(e){setSave('error','บันทึกไม่สำเร็จ เก็บในเครื่องนี้');return false;}
}
function save(now){
  const ok=lsSet(); if(!ok&&!docRef)setSave('error','บันทึกไม่ได้ในเบราว์เซอร์นี้');
  clearTimeout(saveTimer);
  if(now)return pushRemote();
  setSave('saving','กำลังบันทึก');
  saveTimer=setTimeout(pushRemote,600);
}

